// use prisma-8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER_TENANT
  OWNER
  LIAISON
  ADMIN
}

enum ListingType {
  RENT
  SALE
}

enum PropertyType {
  FLAT
  HOUSE
  PLOT
  PG
  SHOP
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

model User {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique
  phone     String?
  role      UserRole  @default(BUYER_TENANT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  properties Property[]
}

model Property {
  id           String            @id @default(uuid())
  title        String
  description  String?
  address      String
  city         String
  state        String
  country      String            @default("India")
  listingType  ListingType
  propertyType PropertyType
  furnished    FurnishingStatus
  bedrooms     Int?
  bathrooms    Int?
  areaSqFt     Int?
  price        Decimal           @db.Decimal(12, 2)
  isFeatured   Boolean           @default(false)
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}
